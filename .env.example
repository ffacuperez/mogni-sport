# Variables de docker-compose.yml. Copiar como .env en esta carpeta y completar. El .env NO se commitea.
# Generar valores al azar con:  openssl rand -base64 48

# Dominio del sitio. En el servidor: el dominio solo (ej. app.mognisport.com), y Caddy saca el certificado HTTPS.
# En la compu: http://localhost
SITE_ADDRESS=http://localhost

# Base de datos (se crea la primera vez que arranca el contenedor de Postgres)
POSTGRES_DB=mogni
POSTGRES_USER=mogni
POSTGRES_PASSWORD=

# Mínimo 32 caracteres. Cambiarlo invalida todas las sesiones abiertas.
JWT_SECRET=

# Notificaciones push (HU-250). Se generan con: npx web-push generate-vapid-keys
# Si se cambian, cada dispositivo tiene que volver a activar las notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Recuperar contraseña (HU-263): mails con Brevo. Vacías = no se manda el mail y el link queda en el log del back.
# El remitente tiene que estar verificado en Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Dirección completa del sitio, con https://: es la base del link que llega por mail (ej. https://app.mognisport.com)
FRONTEND_URL=http://localhost

# Puertos de la compu donde escucha Caddy (en el servidor quedan 80 y 443)
# HTTP_PORT=8088
# HTTPS_PORT=8443

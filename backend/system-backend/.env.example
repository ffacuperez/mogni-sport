# Copiar como .env (en esta misma carpeta) y completar. El .env NO se commitea.
# Spring lo lee solo al arrancar con ./mvnw spring-boot:run, desde IntelliJ o al correr los tests.

# Base de datos, con formato JDBC. Ej.: DB_URL=jdbc:postgresql://localhost:5432/mogni
DB_URL=
DB_USER=
DB_PASSWORD=

# Mínimo 32 caracteres. Cambiarlo invalida todas las sesiones abiertas.
JWT_SECRET=

# Notificaciones push (HU-250). Vacías = el back arranca igual, pero no manda push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
